{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic review DAG fixture contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "source",
    "entry",
    "terminals",
    "handoff",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "const": "dag"
    },
    "source": {
      "type": "string",
      "pattern": "^capability/dag/dag-[a-z0-9-]+/SKILL\\.md$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "terminals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "VERIFIED",
          "UNRESOLVED",
          "BLOCKED",
          "FAILED",
          "NEEDS_APPROVAL"
        ]
      }
    },
    "handoff": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "incident_goal",
          "target_revision",
          "observed_at",
          "owner",
          "current_node",
          "evidence_refs",
          "hypotheses",
          "experiment_results",
          "unresolved_alternatives",
          "authorized_scope",
          "forbidden_actions",
          "next_action",
          "time_budget"
        ]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "depends_on",
          "side_effect",
          "approval",
          "evidence",
          "on_success",
          "on_failure",
          "on_timeout",
          "on_missing_approval",
          "compensation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "side_effect": {
            "type": "string",
            "enum": [
              "none",
              "read-only",
              "mutation"
            ]
          },
          "approval": {
            "type": "string",
            "enum": [
              "none",
              "conditional",
              "required"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "on_success": {
            "type": "string",
            "minLength": 1
          },
          "on_failure": {
            "type": "string",
            "minLength": 1
          },
          "on_timeout": {
            "type": "string",
            "minLength": 1
          },
          "on_missing_approval": {
            "type": [
              "string",
              "null"
            ]
          },
          "compensation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
