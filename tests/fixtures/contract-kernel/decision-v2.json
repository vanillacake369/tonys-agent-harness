{
  "base": {
    "contract_version": 2,
    "request_id": "request-1",
    "task_id": "task-1",
    "session_id": "session-1",
    "role": "implementer",
    "agent": "codex",
    "provider": "codex",
    "policy_revision": "policy-v1",
    "now": 100,
    "resource": {
      "resource_type": "directory",
      "canonical_target": "/workspace/project",
      "operation": "write"
    },
    "secret_access": false,
    "external_mutation": false,
    "provider_can_pause": true,
    "enforcement": {
      "status": "OBSERVED",
      "provider": "codex",
      "provider_version": "0.162.1",
      "evidence_ref": "evidence:probe-1"
    },
    "grants": [{
      "grant_id": "grant-1",
      "task_id": "task-1",
      "session_id": "session-1",
      "role": "implementer",
      "agent": "codex",
      "resource_type": "directory",
      "canonical_target": "/workspace/project",
      "allowed_operations": ["read", "write"],
      "scope": "task",
      "expires_at": 200,
      "end_condition": "task_end",
      "state": "ACTIVE",
      "termination_evidence": null,
      "approval_identity": "human:owner",
      "evidence_ref": "evidence:approval-1",
      "policy_revision": "policy-v1"
    }]
  },
  "cases": [
    {
      "name": "matching grant",
      "patch": {},
      "expected": {"decision": "ALLOW", "reason_code": "active_grant_observed", "grant_id": "grant-1"}
    },
    {
      "name": "secret denial dominates",
      "patch": {"secret_access": true},
      "expected": {"decision": "DENY", "reason_code": "secret_access_forbidden", "grant_id": null}
    },
    {
      "name": "external mutation denial dominates",
      "patch": {"external_mutation": true},
      "expected": {"decision": "DENY", "reason_code": "external_mutation_requires_operation_approval", "grant_id": null}
    },
    {
      "name": "expired grant asks",
      "patch": {"now": 200},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "unobserved enforcement asks",
      "patch": {"enforcement": {"status": "UNOBSERVED"}},
      "expected": {"decision": "ASK", "reason_code": "enforcement_not_observed", "grant_id": null}
    },
    {
      "name": "unpausable missing grant denies",
      "patch": {"provider_can_pause": false, "grants": []},
      "expected": {"decision": "DENY", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "revoked grant asks",
      "patch": {},
      "grant_patch": {"state": "REVOKED", "termination_evidence": "evidence:revoke-1"},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "task isolation asks",
      "patch": {},
      "grant_patch": {"task_id": "task-2"},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "directory prefix escape asks",
      "patch": {"resource": {"canonical_target": "/workspace/project-escape/file"}},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "exact network target allows",
      "patch": {"resource": {"resource_type": "network", "canonical_target": "https://api.example.test:443", "operation": "connect"}},
      "grant_patch": {"resource_type": "network", "canonical_target": "https://api.example.test:443", "allowed_operations": ["connect"]},
      "expected": {"decision": "ALLOW", "reason_code": "active_grant_observed", "grant_id": "grant-1"}
    },
    {
      "name": "network redirect target asks",
      "patch": {"resource": {"resource_type": "network", "canonical_target": "https://redirect.example.test:443", "operation": "connect"}},
      "grant_patch": {"resource_type": "network", "canonical_target": "https://api.example.test:443", "allowed_operations": ["connect"]},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "uppercase network scheme is invalid",
      "patch": {"resource": {"resource_type": "network", "canonical_target": "HTTP://api.example.test:80", "operation": "connect"}},
      "grant_patch": {"resource_type": "network", "canonical_target": "HTTP://api.example.test:80", "allowed_operations": ["connect"]},
      "expected": {"decision": "DENY", "reason_code": "invalid_request", "grant_id": null}
    },
    {
      "name": "unsupported contract version denies",
      "patch": {"contract_version": 1},
      "expected": {"decision": "DENY", "reason_code": "unsupported_contract_version", "grant_id": null}
    },
    {
      "name": "provider observation mismatch denies",
      "patch": {"enforcement": {"provider": "claude"}},
      "expected": {"decision": "DENY", "reason_code": "invalid_enforcement_observation", "grant_id": null}
    },
    {
      "name": "secret denial precedes invalid enforcement",
      "patch": {"secret_access": true, "enforcement": {"provider": "claude"}},
      "expected": {"decision": "DENY", "reason_code": "secret_access_forbidden", "grant_id": null}
    },
    {
      "name": "role isolation asks",
      "patch": {"role": "reviewer"},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "session isolation asks",
      "patch": {"session_id": "session-2"},
      "grant_patch": {"scope": "session", "end_condition": "session_end"},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "policy revision isolation asks",
      "patch": {"policy_revision": "policy-v2"},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "operation mismatch asks",
      "patch": {"resource": {"operation": "delete"}},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "empty grant evidence asks",
      "patch": {},
      "grant_patch": {"evidence_ref": ""},
      "expected": {"decision": "ASK", "reason_code": "matching_active_grant_required", "grant_id": null}
    },
    {
      "name": "malformed network target denies",
      "patch": {"resource": {"resource_type": "network", "canonical_target": "https://api.example.test:0", "operation": "connect"}},
      "expected": {"decision": "DENY", "reason_code": "invalid_request", "grant_id": null}
    },
    {
      "name": "signed network port is not canonical",
      "patch": {"resource": {"resource_type": "network", "canonical_target": "https://api.example.test:+443", "operation": "connect"}},
      "grant_patch": {"resource_type": "network", "canonical_target": "https://api.example.test:+443", "allowed_operations": ["connect"]},
      "expected": {"decision": "DENY", "reason_code": "invalid_request", "grant_id": null}
    }
  ]
}
