{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tony's Agent Harness Tool Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "source",
    "invocation",
    "authority",
    "input",
    "output",
    "failure_statuses",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "kind": { "const": "tool" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*/SKILL\\.md$" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "arguments", "skill_relative_executable"],
      "properties": {
        "command": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+( [A-Za-z0-9_./-]+)*$" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "skill_relative_executable": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*/[A-Za-z0-9_-][A-Za-z0-9_.-]*$" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "writes", "credential_source", "allowed_repository"],
      "properties": {
        "network": { "const": false },
        "writes": { "const": false },
        "credential_source": { "const": "none" },
        "allowed_repository": { "const": "." }
      }
    },
    "input": { "type": "object", "minProperties": 1 },
    "output": { "type": "object", "minProperties": 1 },
    "failure_statuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
    "evidence": { "type": "object", "minProperties": 1 }
  }
}
